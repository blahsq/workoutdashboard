# Token wymagany przy zapisie (POST/DELETE). Wygeneruj np.: openssl rand -hex 32
WORKOUT_TOKEN=

# Wstrzykiwane automatycznie przez integrację Upstash w Vercel Marketplace.
# Lokalnie (vercel env pull / .env.local) wystarczy jedna z par:
KV_REST_API_URL=
KV_REST_API_TOKEN=
